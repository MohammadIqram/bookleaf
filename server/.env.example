# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookleaf?schema=public"

# Authentication & Security
JWT_SECRET="bookleaf_super_secret_jwt_key_min_32_characters_long_for_security"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# AI Provider Configuration ("anthropic" or "openai")
LLM_PROVIDER="anthropic"

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
