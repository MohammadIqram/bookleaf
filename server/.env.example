# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookleaf?schema=public"

# Authentication & Security
JWT_SECRET="bookleaf_super_secret_jwt_key_min_32_characters_long_for_security"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# AI Provider Configuration ("anthropic" or "openai")
LLM_PROVIDER="anthropic"

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# OpenAI / OpenRouter Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# To use OpenRouter instead of OpenAI:
# LLM_PROVIDER="openai"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_API_KEY="sk-or-v1-xxxxxxxx"
# OPENAI_MODEL="anthropic/claude-3-haiku" (or "openai/gpt-4o-mini", "meta-llama/llama-3.1-8b-instruct")
